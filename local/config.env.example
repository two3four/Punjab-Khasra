# Copy this file to config.env and edit. All values are optional.
# How often cached mauzas are re-downloaded (hours)
REFRESH_HOURS=24
# Be gentle with the government server
MAX_CONCURRENCY=2
REQUEST_DELAY=0.4
# 127.0.0.1 = only this PC. 0.0.0.0 = others on your network can open http://<your-pc-ip>:8000
HOST=127.0.0.1
PORT=8000
# Where the cache database is stored
# DB_PATH=D:\cadastral\cadastral.db
